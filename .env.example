# ─────────────────────────────────────────────
# Rep'd Social Media Calendar — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Anthropic Claude API
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth2 (for Google Calendar sync)
# 1. Go to https://console.cloud.google.com
# 2. Create a project or select an existing one
# 3. Enable "Google Calendar API" in the API Library
# 4. Go to Credentials → Create Credentials → OAuth 2.0 Client ID
# 5. Application type: Web application
# 6. Authorized redirect URIs: http://localhost:3001/auth/google/callback
# 7. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-random-string-in-production

# Database path (optional — defaults to server/calendar.db)
# DB_PATH=./calendar.db
